rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) && 
             data.uid == request.auth.uid &&
             data.email is string &&
             data.role in ['customer', 'provider', 'admin'];
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['customerId', 'providerId', 'category', 'scheduledAt', 'status', 'amount']) &&
             data.customerId == request.auth.uid &&
             data.amount is number &&
             data.status in ['pending', 'scheduled', 'ongoing', 'completed', 'cancelled'];
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'loyaltyPoints', 'subscriptionActive', 'subscriptionType'])
      );
    }

    match /providers/{providerId} {
      allow read: if isSignedIn();
      allow create: if isOwner(providerId);
      allow update: if isOwner(providerId);
    }

    match /bookings/{bookingId} {
      allow get: if isSignedIn() && (isOwner(existing().customerId) || isOwner(existing().providerId));
      allow list: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.providerId == request.auth.uid);
      allow create: if isSignedIn() && isValidBooking(incoming());
      allow update: if isSignedIn() && (
        isOwner(existing().customerId) || isOwner(existing().providerId)
      ) && (
        incoming().diff(existing()).affectedKeys().hasAny(['status', 'paymentStatus', 'rating', 'review', 'trackingLocation'])
      );
    }

    match /giftCards/{code} {
      allow get: if isSignedIn();
      allow update: if isSignedIn() && incoming().isUsed == true;
    }
  }
}
